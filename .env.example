# Core: PostgreSQL is the only persistence backend. Never commit a real .env.
APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-bytes
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSLMODE=require
DATA_BACKEND=postgresql
# Optional: defaults to SECRET_KEY; use a distinct 32+ character secret in production.
TRACEABILITY_PSEUDONYM_SECRET=

# Menú 3D: server-only secrets. Never place these values in JavaScript.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MENU3D_PROVIDER=meshy
MESHY_API_KEY=
MESHY_MODEL=meshy-7.1
MENU3D_ASSET_HOSTS=assets.meshy.ai
MENU3D_DAILY_LIMIT=10
MENU3D_COMPANY_BYTES=1073741824
